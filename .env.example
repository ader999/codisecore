DATABASE_URL=postgresql://postgres:password@localhost:5432/codiselu
DB_NAME=codiselu
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DJANGO_SECRET_KEY=tu-secret-key-aqui
DJANGO_DEBUG=True

# S3 Bucket Credentials
USE_S3=False
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# File Upload & Data Limits
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800
FILE_UPLOAD_MAX_MEMORY_SIZE=26214400
DATA_UPLOAD_MAX_NUMBER_FIELDS=2000

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/
FRONTEND_URL=http://localhost:5173

# Google Gemini AI Assistant (Function Calling)
# Obtén tu API Key en Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
